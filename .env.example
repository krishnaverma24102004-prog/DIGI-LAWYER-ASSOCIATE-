# Copy to .env and fill in real values. Never commit .env.

APP_NAME=Digi Lawyer API
# "production" refuses to start with a non-Claude (test) model or a local gateway.
ENVIRONMENT=development
# Record the client's consent to AI processing before a consultation's AI and speech-to-text start.
CONSULTATION_CONSENT_REQUIRED=true

# Supabase (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Public anon / publishable key: used for user-scoped requests, RLS applies.
SUPABASE_ANON_KEY=your-anon-key
# Service role / secret key: bypasses RLS. Server-side only, never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Optional: an Anthropic-compatible gateway (e.g. LiteLLM proxy) instead of api.anthropic.com.
# Put the gateway's key in ANTHROPIC_API_KEY (x-api-key) or ANTHROPIC_AUTH_TOKEN (Authorization: Bearer).
# The model names below must be ones the gateway serves.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
# Set to false if the gateway rejects the server-side fallback beta parameters.
ANTHROPIC_SERVER_FALLBACK=true
# "prompt" for gateways/local models that ignore structured outputs. Ollama (testing only):
#   ANTHROPIC_BASE_URL=http://localhost:11434  ANTHROPIC_API_KEY=ollama  ANTHROPIC_SERVER_FALLBACK=false
#   ANTHROPIC_STRUCTURED_OUTPUT=prompt  and every ANTHROPIC_*_MODEL set to an Ollama model, e.g. gemma4:31b-cloud
ANTHROPIC_STRUCTURED_OUTPUT=native
# Fast model for live analysis, detailed model for the end-of-session summary.
ANTHROPIC_LIVE_MODEL=claude-haiku-5-5
ANTHROPIC_SUMMARY_MODEL=claude-sonnet-5-5
# How much recent transcript is sent with each live analysis request.
LIVE_ANALYSIS_CONTEXT_CHARS=6000

# Deepgram speech-to-text for raw audio on the WebSocket (console.deepgram.com)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_DIARIZE=true

# n8n
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
# Path of the n8n Webhook node called when a session ends: <N8N_WEBHOOK_BASE_URL>/<path>
N8N_POST_CONSULTATION_PATH=post-consultation

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000

# Optional TrueType fonts for PDF reports, needed for non-Western scripts (e.g. Noto Sans).
# Without them, DejaVu Sans / Arial are used if installed, else Helvetica.
PDF_FONT_PATH=
PDF_FONT_BOLD_PATH=

# Legal RAG. Embeddings run locally (fastembed); the model downloads (~210 MB) on first use.
# EMBEDDING_DIMENSIONS must match the vector size in supabase/migrations/004 (768).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSIONS=768
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_WARMUP=true
RAG_ENABLED=true
RAG_TOP_K=3
RAG_MATCH_THRESHOLD=0.55
RAG_REFRESH_SECONDS=20
RAG_MIN_NEW_CHARS=200

# Audit logging: true refuses audited actions (view/export/delete...) if the entry can't be written.
AUDIT_FAIL_CLOSED=false
# Only behind a proxy you control: trust X-Forwarded-For for audit IP addresses.
TRUST_FORWARDED_FOR=false

# PII masking before any LLM call (Presidio + spaCy en_core_web_sm). Names, places and dates are kept.
PII_MASKING_ENABLED=true
PII_SCORE_THRESHOLD=0.4
# PII_ENTITIES=US_SSN,US_ITIN,IN_PAN,CREDIT_CARD,IBAN_CODE,US_BANK_NUMBER,IN_AADHAAR,UK_NHS,US_PASSPORT,IN_PASSPORT,US_DRIVER_LICENSE,IN_VOTER,CRYPTO,EMAIL_ADDRESS,PHONE_NUMBER,IP_ADDRESS

# OCR for scanned PDFs and images. Needs the Tesseract binary; auto-detected when TESSERACT_CMD is empty.
TESSERACT_CMD=
OCR_LANGUAGES=eng
OCR_DPI=300
OCR_MAX_PAGES=50
OCR_MIN_CONFIDENCE=60
# Pages Tesseract can't read are sent as images to Claude vision. Images can't be PII-masked:
# set to false to keep scanned documents entirely on your server.
OCR_VISION_FALLBACK=true
OCR_VISION_MAX_PAGES=10
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5

# Case memory: how many earlier sessions (and characters) of a case thread the agents receive.
CASE_MEMORY_MAX_SESSIONS=5
CASE_MEMORY_MAX_CHARS=6000

# Live web search (external-researcher agent) via Tavily. Queries are generic legal research
# questions written by Claude, never the client's details.
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=
WEB_SEARCH_RAG_THRESHOLD=0.65
WEB_SEARCH_MIN_INTERVAL_SECONDS=60
WEB_SEARCH_MAX_PER_SESSION=10
# Prefer (not restrict to) these domains, comma-separated:
WEB_SEARCH_PREFERRED_DOMAINS=

# Talking mode: Deepgram Aura text-to-speech (uses DEEPGRAM_API_KEY)
TTS_ENABLED=true
TTS_MODEL=aura-2-thalia-en
CONVERSATION_DEBOUNCE_SECONDS=0.8

# WebRTC voice sessions. Add a TURN server for users behind strict NATs.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Detailed analysis model: contract redlines, contradiction reports, drafting.
ANTHROPIC_ANALYSIS_MODEL=claude-sonnet-5-5

# Public https origin of this API, as Twilio reaches it (e.g. https://api.example.com).
PUBLIC_BASE_URL=

# Stripe billing (dashboard -> Developers). One recurring Price per tier; the optional metered
# Price bills audio minutes reported to the meter named STRIPE_METER_EVENT_NAME.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_METERED_PRICE=
STRIPE_METER_EVENT_NAME=audio_minutes
BILLING_STARTER_MINUTES=300
BILLING_PRO_MINUTES=1500
BILLING_ENTERPRISE_MINUTES=10000
BILLING_SUCCESS_URL=http://localhost:3000/?billing=success
BILLING_CANCEL_URL=http://localhost:3000/?billing=cancelled

# Twilio phone intake: point each number's Voice webhook to <PUBLIC_BASE_URL>/api/v1/telephony/voice/incoming
TWILIO_AUTH_TOKEN=
TELEPHONY_VOICE=
# TELEPHONY_DEFAULT_GREETING=Hello, you've reached the firm's legal intake assistant...

# Redis: background jobs (ARQ worker: `arq app.worker.WorkerSettings`) and shared rate limits.
REDIS_URL=
REPORT_STORAGE_BUCKET=reports
N8N_RETRY_BASE_SECONDS=5

# Rate limits per user (or IP), "<count>/<period>".
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LLM=20/minute
RATE_LIMIT_BILLING=10/minute

# Prometheus metrics at /metrics; set a token to require "Authorization: Bearer <token>".
METRICS_ENABLED=true
METRICS_TOKEN=

# Court case data (eCourtsIndia API, https://ecourtsindia.com/api): case status and hearing dates by CNR.
# Without a key, cases are tracked with hand-entered hearing dates.
ECOURTS_API_KEY=
# Hearing reminders: days ahead, and the hour (IST) the worker's daily job runs.
HEARING_REMINDER_DAYS=2
HEARING_REMINDER_HOUR_IST=7

# WhatsApp intake (Meta WhatsApp Cloud API). Webhook: <PUBLIC_BASE_URL>/api/v1/whatsapp/webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Approved template for hearing reminders: {{1}} case title, {{2}} date, {{3}} court.
WHATSAPP_REMINDER_TEMPLATE=hearing_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en

# Indian Kanoon API (case-law search). Its terms require visible "powered by IKanoon" attribution.
INDIANKANOON_API_TOKEN=
